# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=
JWT_EXPIRY=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Private Admin Path (Production: 24-128 chars, letters/numbers/hyphens/underscores only)
ADMIN_PATH=

# Allowed Origins (comma-separated browser origins for WebSocket access in production)
ALLOWED_ORIGINS=

# Supabase (Optional: In-memory fallback is automatically active if not provided)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADS_BUCKET=ad-media

# Redis (Optional: High-performance in-memory cache and metrics store is used by default)
REDIS_URL=
